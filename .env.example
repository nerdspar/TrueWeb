# TrueWeb — environment configuration.
# Copy to .env and fill in. .env is gitignored: no secrets in the repo (§7).

# ── TrueNAS middleware connection (Milestone 1) ──────────────────────────────
# Host (and optional :port) of the TrueNAS box. The client builds
# wss://<host>/api/current from this. Connect to the box directly on the LAN, by
# IP, NOT through the reverse proxy (§10). Include the port if a proxy occupies
# 443 on this IP: when Nginx Proxy Manager fronts 443, TrueNAS's own UI listens
# on 444 (HTTPS) / 81 (HTTP), so use the 444 endpoint. A scheme or trailing
# slash is stripped; an explicit :port is kept.
TRUENAS_HOST=10.0.1.14:444

# Service-account API key (§7). A user-linked key on a dedicated account holding
# only the roles this app needs — NOT a FULL_ADMIN key. Never logged, never
# returned in a response, never written to disk.
TRUENAS_API_KEY=

# Username the API key belongs to. Required: the client authenticates with
# auth.login_ex (mechanism API_KEY_PLAIN), which takes username + api_key.
# (auth.login_with_api_key is deprecated on 25.10 and removed in TrueNAS 26.)
TRUENAS_API_KEY_USERNAME=

# Verify the middleware's TLS certificate. TrueNAS ships a self-signed cert, so
# LAN deployments usually set this false. Anything other than "false" (case
# -insensitive) is treated as true. When unset, it defaults to true.
TRUENAS_VERIFY_TLS=false

# Optional: path to a PEM CA bundle to trust instead of disabling verification.
# TRUENAS_CA_FILE=/path/to/truenas-ca.pem

# Optional: TLS SNI server name. Leave unset for the direct LAN path (an IP host
# sends no SNI, which is what TrueNAS's own nginx expects). Set it only if you
# must reach the middleware through a name-based reverse proxy that requires a
# specific SNI — the non-§10 path.
# TRUENAS_TLS_SERVERNAME=truenas.example.com

# ── App gate + backend (Milestone 2+, not read by the M1 CLI) ────────────────
# Shared passcode as a bcrypt hash (§7). A speed bump, not real authz.
# TRUEWEB_PASSCODE_HASH=
# Port the TrueWeb backend listens on.
# TRUEWEB_PORT=8110
